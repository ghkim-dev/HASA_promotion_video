# .env 로 복사해서 사용. .env 는 공유·업로드 금지.
OASH_API_KEY=sk-dev-여기에_개발키
OASH_BASE_URL=https://open.hasa.re.kr/v1

# 비워 두면 /v1/models 에서 역할별로 자동 선택 (text=qwen3-next-80b, vision=qwen3-vl-32b, video=wan2.2-i2v)
OASH_TEXT_MODEL=
OASH_VISION_MODEL=
OASH_VIDEO_MODEL=
# 이름에 i2v가 없는 모델(예: LTX-2)에 첫 프레임 이미지를 보내 보려면 1
OASH_VIDEO_ACCEPTS_IMAGE=0
OASH_VIDEO_STEPS=20

# 키의 동시 요청 한도 (개발키 1건). 실증키·운영키로 한도가 늘면 같이 올리면 후보 영상을 병렬 생성
OASH_MAX_CONCURRENCY=1
OASH_TIMEOUT=600

# 움직임 지표가 이 값(%)보다 작으면 '거의 정지'로 판정 (모델·해상도에 따라 조정)
VS_STATIC_THRESHOLD=0.35

# ---- 장편 모드
# 비우면 Qwen-Image-Edit 자동 선택 (새 장소 씬 키프레임)
OASH_IMAGE_EDIT_MODEL=
# 비우면 melotts-ko 자동 선택 (--narration)
OASH_TTS_MODEL=
# 실측 전 영상 1건 예상 시간(초) — 실제 Hub 실측 평균 45~50초 (wan2.2-i2v, 640x480, 약 4초)
VS_EST_JOB_SECONDS=50
# 씬 앵커 대비 색 거리가 이보다 크면 다음 샷 시작 전 색 보정
VS_DRIFT_DELTA_E=6
# 영상 생성 일시 오류 시 재시도 대기(초)
VS_NET_RETRY_SLEEP=10

# ---- 멀티모달 지식 저장소 (rag)
# 비우면 qwen3-embedding-4b → bge-m3 → nemotron-embed-8b 순으로 자동 선택 (한 저장소는 한 모델로 유지)
OASH_EMBED_MODEL=
# 이미지 직접 임베딩 모델 (비우면 nemotron-embed 등을 시험해 보고 안 되면 사진 설명문으로 검색). off = 끔
OASH_IMAGE_EMBED_MODEL=
# 비우면 bge-reranker-v2-m3-ko 우선
OASH_RERANK_MODEL=
# 영상 하나에서 뽑는 최대 구간 수
VS_RAG_MAX_SEGMENTS=40
# VLM에 mp4를 직접 보낼지 (실제 Hub 점검: qwen3-vl-32b 가능). 0이면 프레임 이미지로
VS_VLM_VIDEO=1
# 글자 있는 사진의 OCR (비우면 schift-ocr-1-beta 우선 — 점검에서 paddleocr-vl보다 정확)
OASH_OCR_MODEL=

# ---- 토큰 예산
# max(기본): 모델 최대 길이의 60%까지 근거를 채우고, 답변 최대 16K, 검사 3회 다수결, 계획 후보 3개 중 선택
# balanced: 근거 25%, 답변 4K, 검사 1회 / eco: 예전 방식
VS_TOKEN_MODE=max
# 하루 토큰 예산 (입력+출력). 90%를 넘으면 그날은 자동으로 eco
VS_DAILY_TOKEN_BUDGET=20000000
